generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  analyses      Analysis[]
  routines      Routine[]
  habits        Habit[]
  journal       JournalEntry[]
  goals         Goal[]
  focusSessions FocusSession[]
  sleepLogs     SleepLog[]
  waterLogs     WaterLog[]
  weeklyReviews WeeklyReview[]
  xpLogs        XPLog[]
}

model Analysis {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  overallScore   Float
  potentialScore Float
  featuresJson   String
  summary        String

  @@index([sessionId])
}

model Routine {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id])
  name      String        @default("Morning Routine")
  steps     RoutineStep[]
  logs      RoutineLog[]

  @@index([sessionId])
}

model RoutineStep {
  id          String  @id @default(cuid())
  routineId   String
  routine     Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  icon        String  @default("✓")
  durationSec Int     @default(0)
  isActive    Boolean @default(true)

  @@index([routineId])
}

model RoutineLog {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dateKey     String

  @@unique([routineId, dateKey])
  @@index([routineId])
}

model Habit {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id])
  name      String
  icon      String     @default("⭐")
  category  String     @default("general")
  isActive  Boolean    @default(true)
  logs      HabitLog[]

  @@index([sessionId])
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  dateKey String

  @@unique([habitId, dateKey])
  @@index([habitId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  imageData String
  note      String?
  mood      Int?

  @@index([sessionId])
}

model Goal {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  text        String
  dateKey     String
  completed   Boolean  @default(false)
  carriedOver Boolean  @default(false)

  @@index([sessionId, dateKey])
}

model FocusSession {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id])
  durationMin Int
  type        String    @default("work")
  completedAt DateTime?

  @@index([sessionId])
}

model SleepLog {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
  dateKey   String
  hours     Float
  quality   Int

  @@unique([sessionId, dateKey])
  @@index([sessionId])
}

model WaterLog {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
  dateKey   String
  glasses   Int     @default(0)

  @@unique([sessionId, dateKey])
  @@index([sessionId])
}

model WeeklyReview {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
  weekKey   String
  rating    Int
  note      String?

  @@unique([sessionId, weekKey])
  @@index([sessionId])
}

model XPLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  amount    Int
  reason    String

  @@index([sessionId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String
  category    String
  priceMin    Float
  priceMax    Float
  imageEmoji  String  @default("🛍️")
  tags        String
  buyUrl      String  @default("#")
}
