# ─── Anthropic (Claude AI) ────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── SMS ─────────────────────────────────────────────────────────────────────
# Choose your SMS provider:
#   "textbelt"  — FREE option. 1 free SMS/day (key="textbelt"), no account needed.
#                 For more volume, buy credits at textbelt.com (~$0.006/SMS, no subscription).
#   "twilio"    — Twilio. Free $15.50 trial at twilio.com (~2,000 SMS).
#
SMS_PROVIDER=textbelt

# TextBelt key — use "textbelt" for 1 free SMS/day, or buy a key at textbelt.com
TEXTBELT_KEY=textbelt

# Twilio (only needed if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1...

# ─── Email (Gmail SMTP — FREE) ────────────────────────────────────────────────
# 1. Enable 2-Factor Auth on your Google account
# 2. Go to: myaccount.google.com → Security → App Passwords
# 3. Create an app password for "Mail" — use that 16-char code below
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Calling ─────────────────────────────────────────────────────────────────
# Calling is FREE — no API needed.
# The app generates an AI call script and opens your phone dialer via tel: link.
# No external service required.

# ─── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_APP_URL=http://localhost:3001
